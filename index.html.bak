    <!-- JAVASCRIPT NOTEBOOK CONTROLLER -->
    <script>
        // State
        let activeProgramId = 'A1';
        let voiceEnabled = false;

        document.addEventListener('DOMContentLoaded', () => {
            initNotebook();
        });

        function initNotebook() {
            populateHeaderDropdown();
            renderTOCList();
            loadProgramIntoNotebook(activeProgramId);
            initSettingsState();
            lucide.createIcons();
        }

        // Header & Mobile Program Dropdowns
        function populateHeaderDropdown() {
            const selects = [
                document.getElementById('header-program-select'),
                document.getElementById('mobile-program-select')
            ].filter(Boolean);

            selects.forEach(select => {
                select.innerHTML = '';

                const groupA = document.createElement('optgroup');
                groupA.label = "Part A: SQL Queries";

                const groupB = document.createElement('optgroup');
                groupB.label = "Part B: PL/SQL Programs";

                DBMS_PROGRAMS.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = `${p.id}: ${p.title}`;
                    if (p.id.startsWith('A')) {
                        groupA.appendChild(opt);
                    } else {
                        groupB.appendChild(opt);
                    }
                });

                select.appendChild(groupA);
                select.appendChild(groupB);
            });
        }

        function onProgramSelectChange(progId) {
            loadProgramIntoNotebook(progId);
        }

        function navigateToPreviousProgram() {
            const idx = DBMS_PROGRAMS.findIndex(p => p.id === activeProgramId);
            if (idx > 0) {
                loadProgramIntoNotebook(DBMS_PROGRAMS[idx - 1].id);
            }
        }

        function navigateToNextProgram() {
            const idx = DBMS_PROGRAMS.findIndex(p => p.id === activeProgramId);
            if (idx < DBMS_PROGRAMS.length - 1) {
                loadProgramIntoNotebook(DBMS_PROGRAMS[idx + 1].id);
            }
        }

        // Main Program Loader
        function loadProgramIntoNotebook(progId) {
            activeProgramId = progId;
            window.aiTutor.selectedProgramId = progId;

            const prog = DBMS_PROGRAMS.find(p => p.id === progId) || DBMS_PROGRAMS[0];
            const idx = DBMS_PROGRAMS.findIndex(p => p.id === progId);

            // Update Both Desktop & Mobile Dropdowns
            const headerSelect = document.getElementById('header-program-select');
            if (headerSelect) headerSelect.value = progId;

            const mobileSelect = document.getElementById('mobile-program-select');
            if (mobileSelect) mobileSelect.value = progId;

            const isFirst = (idx === 0);
            const isLast = (idx === DBMS_PROGRAMS.length - 1);

            const btnPrev = document.getElementById('btn-prev-prog');
            if (btnPrev) btnPrev.disabled = isFirst;
            const btnNext = document.getElementById('btn-next-prog');
            if (btnNext) btnNext.disabled = isLast;

            const btnPrevMobile = document.getElementById('btn-prev-prog-mobile');
            if (btnPrevMobile) btnPrevMobile.disabled = isFirst;
            const btnNextMobile = document.getElementById('btn-next-prog-mobile');
            if (btnNextMobile) btnNextMobile.disabled = isLast;

            // 1. Chapter Header Cell
            document.getElementById('nb-part-badge').textContent = `${prog.part} · Program ${prog.progNum}`;
            document.getElementById('nb-category-badge').textContent = prog.category || (prog.part === 'Part A' ? 'SQL Table DDL & Queries' : 'PL/SQL Program Script');
            document.getElementById('nb-progress-counter').textContent = `Lab ${idx + 1} of ${DBMS_PROGRAMS.length}`;
            document.getElementById('nb-title').textContent = `${prog.id}: ${prog.title}`;
            document.getElementById('nb-description').textContent = prog.description;
            document.getElementById('nb-memory-anchor').textContent = prog.memoryTip || 'Understand the execution order: FROM -> WHERE -> GROUP BY -> HAVING -> SELECT -> ORDER BY.';

            // Render Concept Badges
            renderConceptsPills(prog);

            // 2. Schema Cell
            renderSchemaCell(prog);

            // 3. Queries Cell
            renderQueriesCell(prog);

            // 4. Practice Scratchpad
            renderPracticeSelect(prog);
            clearPracticeFeedback();

            // 5. Viva Voce
            renderVivaCell(prog);

            // 6. Discussion Prompts
            renderDiscussionChips(prog);

            // Reset discussion feed greeting for new chapter
            resetDiscussionGreeting(prog);

            // Scroll to top smoothly
            window.scrollTo({ top: 0, behavior: 'smooth' });

            lucide.createIcons();
        }

        function renderConceptsPills(prog) {
            const container = document.getElementById('nb-concepts-container');
            container.innerHTML = '';

            const concepts = prog.concepts || ['SQL', 'Oracle', 'RDBMS'];
            concepts.forEach(c => {
                const pill = document.createElement('button');
                pill.className = "px-2.5 py-1 rounded-full text-[11px] font-mono bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition-colors active:scale-95 shadow-2xs";
                pill.textContent = `#${c}`;
                pill.onclick = () => {
                    askThanganAboutQueryTopic(c);
                };
                container.appendChild(pill);
            });
        }

        // Render Schema
        function renderSchemaCell(prog) {
            const container = document.getElementById('nb-schema-content');
            const countLabel = document.getElementById('nb-table-count');
            container.innerHTML = '';

            if (!prog.tables || prog.tables.length === 0) {
                countLabel.textContent = "Algorithm Lab";
                container.innerHTML = `
                    <div class="p-3.5 sm:p-4 bg-slate-50 rounded-lg border border-slate-200 text-xs text-slate-600 flex items-start gap-2.5">
                        <i data-lucide="info" class="w-4 h-4 text-blue-600 shrink-0 mt-0.5"></i>
                        <p>This experiment focuses on mathematical and algorithmic PL/SQL subprograms (procedures, functions, and recursive routines) without an underlying database table.</p>
                    </div>
                `;
                return;
            }

            countLabel.textContent = `${prog.tables.length} Table${prog.tables.length > 1 ? 's' : ''}`;

            prog.tables.forEach(t => {
                const card = document.createElement('div');
                card.className = "space-y-3 p-3.5 sm:p-4 bg-slate-50/70 rounded-lg border border-slate-200";

                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 sm:gap-2 truncate">
                            <span class="text-xs font-bold text-slate-900 font-mono">${escapeHtml(t.name)}</span>
                            <span class="text-[11px] text-slate-500 hidden sm:inline">(${escapeHtml(t.columns)})</span>
                        </div>
                        <button onclick="copyToClipboard(this, \`${escapeJsString(t.createSql)}\`)" class="text-xs bg-white hover:bg-slate-100 text-slate-700 px-2.5 py-1.5 rounded-md border border-slate-200 flex items-center gap-1 transition-colors active:scale-95 shadow-2xs shrink-0">
                            <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500"></i>
                            <span class="text-[11px]">Copy DDL</span>
                        </button>
                    </div>

                    <div class="code-container p-3 sm:p-3.5 overflow-x-auto text-[11px] sm:text-xs">
                        <pre><code>${escapeHtml(t.createSql)}</code></pre>
                    </div>
                `;

                // If sample data exists, render clean responsive table view
                if (t.sampleRecords && t.sampleRecords.length > 0) {
                    const preview = document.createElement('div');
                    preview.className = "pt-2";
                    preview.innerHTML = `
                        <div class="text-[11px] font-semibold text-slate-600 mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span>Sample Table Records:</span>
                                <span class="sm:hidden text-[10px] text-blue-600 font-normal">👈 Swipe table 👉</span>
                            </div>
                            <span class="font-normal text-slate-400 font-mono">${t.sampleRecords.length} rows</span>
                        </div>
                        <div class="overflow-x-auto border border-slate-200 rounded-md bg-white -mx-0.5 sm:mx-0 shadow-2xs">
                            <table class="w-full text-xs text-left min-w-[340px]">
                                <thead class="bg-slate-100/90 text-slate-700 uppercase font-semibold text-[10px]">
                                    <tr>
                                        ${Object.keys(t.sampleRecords[0]).map(k => `<th class="px-2.5 py-1.5 border-b border-slate-200 whitespace-nowrap">${escapeHtml(k)}</th>`).join('')}
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    ${t.sampleRecords.map(r => `
                                        <tr class="hover:bg-slate-50/80">
                                            ${Object.values(r).map(v => `<td class="px-2.5 py-1.5 font-mono text-[11px] sm:text-xs text-slate-700 whitespace-nowrap">${escapeHtml(String(v))}</td>`).join('')}
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                    card.appendChild(preview);
                }

                container.appendChild(card);
            });
        }

        // Render Queries
        function renderQueriesCell(prog) {
            const container = document.getElementById('nb-queries-content');
            const countBadge = document.getElementById('nb-queries-count');
            const titleLabel = document.getElementById('nb-queries-title');
            container.innerHTML = '';

            if (prog.queries && prog.queries.length > 0) {
                titleLabel.textContent = "Lab Queries & Official Solutions";
                countBadge.textContent = `${prog.queries.length} Queries`;

                prog.queries.forEach((q, idx) => {
                    const block = document.createElement('div');
                    block.className = "space-y-3 pb-5 border-b border-slate-100 last:border-b-0 last:pb-0";

                    // Header row: Query letter & Question prompt & Actions
                    const header = document.createElement('div');
                    header.className = "flex flex-col sm:flex-row sm:items-start justify-between gap-2 sm:gap-3";
                    header.innerHTML = `
                        <div class="flex items-start gap-2 sm:gap-2.5 flex-1 min-w-0">
                            <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-mono font-bold text-xs border border-blue-200 shrink-0 mt-0.5">
                                ${escapeHtml(q.label)}
                            </span>
                            <h3 class="text-xs sm:text-sm font-semibold text-slate-900 leading-snug">
                                ${escapeHtml(q.question)}
                            </h3>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-start">
                            <button onclick="copyToClipboard(this, \`${escapeJsString(q.sql)}\`)" class="text-xs bg-slate-50 hover:bg-slate-100 text-slate-700 px-2.5 py-1.5 rounded-md border border-slate-200 flex items-center gap-1 transition-colors shadow-2xs active:scale-95" title="Copy SQL">
                                <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500"></i>
                                <span class="text-[11px] sm:text-xs">Copy</span>
                            </button>
                            <button onclick="askThanganAboutSpecificQuery('${prog.id}', '${q.label}')" class="text-xs text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-2.5 py-1.5 rounded-md border border-blue-100 transition-colors flex items-center gap-1 active:scale-95" title="Ask Professor Thangan">
                                <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
                                <span class="text-[11px] sm:text-xs font-medium">Ask Thangan</span>
                            </button>
                        </div>
                    `;
                    block.appendChild(header);

                    // Code Container
                    const code = document.createElement('div');
                    code.className = "code-container p-3 sm:p-3.5 overflow-x-auto text-[11px] sm:text-xs";
                    code.innerHTML = `<pre><code>${escapeHtml(q.sql)}</code></pre>`;
                    block.appendChild(code);

                    // Inline Thangan's Explanation (Collapsible)
                    const breakdown = document.createElement('details');
                    breakdown.className = "bg-slate-50/80 border border-slate-200 rounded-lg p-3 text-xs";
                    breakdown.innerHTML = `
                        <summary class="cursor-pointer font-semibold text-blue-700 select-none flex items-center gap-1.5">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-blue-600"></i>
                            <span>💡 Thangan's Logic Breakdown</span>
                        </summary>
                        <div class="mt-2.5 space-y-2 text-slate-600 leading-relaxed pl-3.5 sm:pl-5 border-l-2 border-blue-200">
                            <p><strong class="text-slate-800">Why this works:</strong> ${escapeHtml(q.explanation)}</p>
                            ${q.keyPoints && q.keyPoints.length > 0 ? `
                                <div class="flex flex-wrap gap-1.5 pt-1">
                                    ${q.keyPoints.map(kp => `<span class="bg-white border border-slate-200 text-slate-700 px-2 py-0.5 rounded text-[11px]">• ${escapeHtml(kp)}</span>`).join('')}
                                </div>
                            ` : ''}
                            ${q.output ? `
                                <p class="text-[11px] text-slate-500 pt-1">
                                    <strong>Expected Output:</strong> <span class="font-mono text-slate-800">${escapeHtml(q.output)}</span>
                                </p>
                            ` : ''}
                        </div>
                    `;
                    block.appendChild(breakdown);

                    container.appendChild(block);
                });
            } else if (prog.plsql) {
                titleLabel.textContent = "Full Executable PL/SQL Program";
                countBadge.textContent = "PL/SQL Script";

                const block = document.createElement('div');
                block.className = "space-y-3";

                block.innerHTML = `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <span class="text-xs font-semibold text-slate-700">Complete Source Code:</span>
                        <div class="flex items-center gap-1.5">
                            <button onclick="copyToClipboard(this, \`${escapeJsString(prog.plsql)}\`)" class="text-xs bg-slate-50 hover:bg-slate-100 text-slate-700 px-2.5 py-1.5 rounded-md border border-slate-200 flex items-center gap-1 transition-colors shadow-2xs active:scale-95">
                                <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500"></i>
                                <span>Copy Code</span>
                            </button>
                            <button onclick="askThanganToTeachPLSQL('${prog.id}')" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-2.5 py-1.5 rounded-md border border-blue-200 flex items-center gap-1 transition-colors active:scale-95">
                                <i data-lucide="sparkles" class="w-3.5 h-3.5 text-blue-600"></i>
                                <span>Explain with Thangan</span>
                            </button>
                        </div>
                    </div>
                    <div class="code-container p-3 sm:p-4 overflow-x-auto text-[11px] sm:text-xs leading-relaxed max-h-[460px]">
                        <pre><code>${escapeHtml(prog.plsql)}</code></pre>
                    </div>
                `;
                container.appendChild(block);
            }
        }

        // Render Practice Select
        function renderPracticeSelect(prog) {
            const select = document.getElementById('nb-practice-select');
            select.innerHTML = '';

            if (prog.queries) {
                prog.queries.forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = q.id;
                    opt.textContent = `${q.label}: ${q.question}`;
                    select.appendChild(opt);
                });
            } else {
                const opt = document.createElement('option');
                opt.value = 'full_plsql';
                opt.textContent = `Full ${prog.title} Execution`;
                select.appendChild(opt);
            }

            document.getElementById('nb-practice-input').value = '';
        }

        function onNotebookPracticeSelectChange() {
            clearPracticeFeedback();
            document.getElementById('nb-practice-input').value = '';
        }

        function loadPracticeSolution() {
            const prog = DBMS_PROGRAMS.find(p => p.id === activeProgramId);
            const select = document.getElementById('nb-practice-select');
            const selectedVal = select.value;
            let code = '';
            if (prog.queries) {
                const q = prog.queries.find(item => item.id === selectedVal) || prog.queries[0];
                code = q.sql;
            } else if (prog.plsql) {
                code = prog.plsql;
            }
            document.getElementById('nb-practice-input').value = code;
        }

        function clearPracticeInput() {
            document.getElementById('nb-practice-input').value = '';
            clearPracticeFeedback();
        }

        function clearPracticeFeedback() {
            const feedbackBox = document.getElementById('nb-practice-feedback');
            feedbackBox.classList.add('hidden');
            feedbackBox.innerHTML = '';
        }

        async function checkPracticeWithThangan() {
            const input = document.getElementById('nb-practice-input').value.trim();
            if (!input) {
                alert('Please enter or paste your SQL query first.');
                return;
            }

            const feedbackBox = document.getElementById('nb-practice-feedback');
            feedbackBox.classList.remove('hidden');
            feedbackBox.innerHTML = `
                <div class="flex items-center gap-2.5 text-blue-700 font-medium py-1">
                    <div class="w-3.5 h-3.5 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></div>
                    <span>Professor Thangan is analyzing your SQL syntax and logic against the syllabus...</span>
                </div>
            `;

            const prompt = `Review my student SQL code for ${activeProgramId}: \n\`\`\`sql\n${input}\n\`\`\`\nCheck if this correctly satisfies the requirements from the record. Flag any errors, provide the correction, and give a score out of 10.`;
            
            window.aiTutor.setMode('doctor');
            try {
                const res = await window.aiTutor.ask(prompt);
                feedbackBox.innerHTML = `
                    <div class="ai-markdown text-slate-800">
                        ${marked.parse(res)}
                    </div>
                `;
            } catch (err) {
                feedbackBox.innerHTML = `
                    <p class="text-rose-600 font-medium">Evaluation error: ${escapeHtml(err.message)}</p>
                `;
            }
            lucide.createIcons();
        }

        // Render Viva Voce Cell
        function renderVivaCell(prog) {
            const container = document.getElementById('nb-viva-list');
            container.innerHTML = '';

            const questions = prog.vivaQuestions || VIVA_BANK.slice(0, 3);
            questions.forEach((vq, i) => {
                const item = document.createElement('div');
                item.className = "p-3.5 bg-slate-50/70 border border-slate-200 rounded-lg space-y-2";

                item.innerHTML = `
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2.5 sm:gap-3">
                        <h4 class="text-xs font-semibold text-slate-900 leading-snug">
                            <span class="text-emerald-700 font-bold mr-1">Q${i+1}.</span> ${escapeHtml(vq.q)}
                        </h4>
                        <button onclick="askThanganVivaQuestion(\`${escapeJsString(vq.q)}\`)" class="text-[11px] bg-white hover:bg-slate-100 text-blue-600 px-2.5 py-1.5 rounded-md border border-slate-200 font-medium transition-colors shrink-0 self-start active:scale-95 shadow-2xs">
                            Oral Exam Prep
                        </button>
                    </div>

                    <details class="text-xs text-slate-700 bg-white p-2.5 rounded-md border border-slate-200">
                        <summary class="cursor-pointer text-blue-600 font-medium select-none">Reveal Examiner Model Answer</summary>
                        <p class="mt-1.5 text-slate-600 leading-relaxed">${escapeHtml(vq.a || vq.modelAnswer)}</p>
                    </details>
                `;

                container.appendChild(item);
            });
        }

        // Render Discussion Chips (Horizontal Swipe on Mobile)
        function renderDiscussionChips(prog) {
            const container = document.getElementById('nb-discussion-chips');
            container.innerHTML = '';

            const chips = [
                `Thangan, teach me ${prog.id} step-by-step`,
                `What are common exam mistakes in ${prog.id}?`,
                `Explain all queries in ${prog.id} simply`,
                `Conduct a mock viva exam for ${prog.id}`
            ];

            chips.forEach(chipText => {
                const btn = document.createElement('button');
                btn.className = "text-[11px] bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap transition-colors shrink-0 shadow-2xs active:scale-95";
                btn.textContent = chipText;
                btn.onclick = () => {
                    document.getElementById('nb-discussion-input').value = chipText;
                    handleNotebookDiscussionSubmit(new Event('submit'));
                };
                container.appendChild(btn);
            });
        }

        function resetDiscussionGreeting(prog) {
            const feed = document.getElementById('nb-discussion-feed');
            feed.innerHTML = `
                <div class="flex gap-3">
                    <div class="w-7 h-7 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                        T
                    </div>
                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs text-slate-700 leading-relaxed max-w-[92%]">
                        <p class="font-semibold text-slate-900 mb-1">Loaded: ${escapeHtml(prog.id)} — ${escapeHtml(prog.title)}</p>
                        <p>I'm ready to teach the complete code, explain constraints, or simulate your oral viva exam. What would you like to explore?</p>
                    </div>
                </div>
            `;
            window.aiTutor.conversationHistory = [];
        }

        // Discussion Message Handling
        async function handleNotebookDiscussionSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('nb-discussion-input');
            const text = input.value.trim();
            if (!text) return;

            input.value = '';
            appendDiscussionMessage('user', text);
            const typingId = showDiscussionTyping();

            try {
                const aiResponse = await window.aiTutor.ask(text);
                removeDiscussionTyping(typingId);
                appendDiscussionMessage('ai', aiResponse);

                if (voiceEnabled) {
                    window.aiTutor.speak(aiResponse);
                }
            } catch (err) {
                removeDiscussionTyping(typingId);
                appendDiscussionMessage('ai', `An error occurred: ${err.message}. Switched to local offline knowledge engine.`);
            }
        }

        function appendDiscussionMessage(role, content) {
            const feed = document.getElementById('nb-discussion-feed');
            const row = document.createElement('div');

            if (role === 'user') {
                row.className = "flex justify-end";
                row.innerHTML = `
                    <div class="bg-blue-600 rounded-lg p-2.5 px-3 max-w-[85%] text-xs text-white shadow-sm leading-relaxed">
                        ${escapeHtml(content)}
                    </div>
                `;
            } else {
                row.className = "flex gap-3";
                const rendered = marked.parse(content);
                row.innerHTML = `
                    <div class="w-7 h-7 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                        T
                    </div>
                    <div class="bg-white border border-slate-200 rounded-lg p-3 max-w-[92%] text-xs text-slate-800 ai-markdown shadow-sm">
                        ${rendered}
                        <div class="flex items-center gap-2 mt-2 pt-2 border-t border-slate-100 text-[10px] text-slate-400">
                            <button onclick="window.aiTutor.speak(\`${escapeJsString(content)}\`)" class="hover:text-blue-600 flex items-center gap-1">
                                <i data-lucide="volume-2" class="w-3 h-3 text-blue-600"></i>
                                <span>Listen</span>
                            </button>
                            <span>•</span>
                            <button onclick="copyToClipboard(this, \`${escapeJsString(content)}\`)" class="hover:text-blue-600 flex items-center gap-1">
                                <i data-lucide="copy" class="w-3 h-3"></i>
                                <span>Copy</span>
                            </button>
                        </div>
                    </div>
                `;
            }

            feed.appendChild(row);
            feed.scrollTop = feed.scrollHeight;
            lucide.createIcons();
        }

        function showDiscussionTyping() {
            const feed = document.getElementById('nb-discussion-feed');
            const id = 'typing-' + Date.now();
            const div = document.createElement('div');
            div.id = id;
            div.className = "flex gap-3";
            div.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                    T
                </div>
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5 flex items-center gap-1.5 shadow-sm">
                    <div class="w-1.5 h-1.5 bg-blue-600 rounded-full typing-dot"></div>
                    <div class="w-1.5 h-1.5 bg-blue-600 rounded-full typing-dot"></div>
                    <div class="w-1.5 h-1.5 bg-blue-600 rounded-full typing-dot"></div>
                </div>
            `;
            feed.appendChild(div);
            feed.scrollTop = feed.scrollHeight;
            return id;
        }

        function removeDiscussionTyping(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function clearDiscussionThread() {
            const prog = DBMS_PROGRAMS.find(p => p.id === activeProgramId);
            resetDiscussionGreeting(prog);
            lucide.createIcons();
        }

        function toggleVoiceSpeech() {
            voiceEnabled = !voiceEnabled;
            const btn = document.getElementById('nb-voice-toggle');
            if (voiceEnabled) {
                btn.className = "p-1.5 rounded bg-blue-600 text-white transition-colors";
                btn.title = "Voice Speech: Active";
            } else {
                btn.className = "p-1.5 rounded hover:bg-slate-100 text-slate-500 hover:text-slate-800 transition-colors";
                btn.title = "Voice Speech: Disabled";
                window.aiTutor.stopSpeaking();
            }
        }

        // Quick Contextual Triggers & Scroll Helpers
        function scrollToPractice() {
            const el = document.getElementById('nb-practice-section');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                setTimeout(() => {
                    const input = document.getElementById('nb-practice-input');
                    if (input) input.focus();
                }, 350);
            }
        }

        function scrollToViva() {
            const el = document.getElementById('nb-viva-section');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function scrollToDiscussion() {
            const el = document.getElementById('nb-discussion-section');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                setTimeout(() => {
                    const input = document.getElementById('nb-discussion-input');
                    if (input) input.focus();
                }, 350);
            }
        }

        function askThanganAboutSpecificQuery(progId, queryLabel) {
            scrollToDiscussion();
            window.aiTutor.setMode('explainer');
            document.getElementById('nb-discussion-input').value = `Thangan, explain ${queryLabel} from Program ${progId} line-by-line and show why the clauses are ordered this way.`;
            handleNotebookDiscussionSubmit(new Event('submit'));
        }

        function askThanganToTeachPLSQL(progId) {
            scrollToDiscussion();
            window.aiTutor.setMode('explainer');
            document.getElementById('nb-discussion-input').value = `Thangan, teach me the complete PL/SQL program for ${progId} step-by-step.`;
            handleNotebookDiscussionSubmit(new Event('submit'));
        }

        function askThanganVivaQuestion(questionText) {
            scrollToDiscussion();
            window.aiTutor.setMode('viva');
            document.getElementById('nb-discussion-input').value = `Thangan, examine me on this viva question: "${questionText}".`;
            handleNotebookDiscussionSubmit(new Event('submit'));
        }

        function askThanganAboutQueryTopic(topic) {
            scrollToDiscussion();
            window.aiTutor.setMode('tutor');
            document.getElementById('nb-discussion-input').value = `Thangan, explain how "${topic}" is applied in ${activeProgramId}.`;
            handleNotebookDiscussionSubmit(new Event('submit'));
        }

        // Table of Contents (TOC) Modal
        function toggleTOCModal() {
            const modal = document.getElementById('toc-modal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                document.getElementById('toc-search').focus();
            }
        }

        function renderTOCList() {
            const container = document.getElementById('toc-content-list');
            container.innerHTML = '';

            const partA = DBMS_PROGRAMS.filter(p => p.id.startsWith('A'));
            const partB = DBMS_PROGRAMS.filter(p => p.id.startsWith('B'));

            // Part A Group
            const groupA = document.createElement('div');
            groupA.innerHTML = `
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Part A: SQL Lab Queries (1–7)</div>
                <div class="space-y-1" id="toc-part-a"></div>
            `;
            container.appendChild(groupA);

            const listA = groupA.querySelector('#toc-part-a');
            partA.forEach(p => {
                const btn = createTOCItem(p);
                listA.appendChild(btn);
            });

            // Part B Group
            const groupB = document.createElement('div');
            groupB.innerHTML = `
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2 pt-2">Part B: PL/SQL Programs (1–7)</div>
                <div class="space-y-1" id="toc-part-b"></div>
            `;
            container.appendChild(groupB);

            const listB = groupB.querySelector('#toc-part-b');
            partB.forEach(p => {
                const btn = createTOCItem(p);
                listB.appendChild(btn);
            });
        }

        function createTOCItem(prog) {
            const btn = document.createElement('button');
            btn.className = "w-full text-left p-2.5 rounded-lg flex items-center justify-between hover:bg-slate-100 transition-colors border border-transparent hover:border-slate-200 toc-item";
            btn.onclick = () => {
                toggleTOCModal();
                loadProgramIntoNotebook(prog.id);
            };

            btn.innerHTML = `
                <div class="flex items-center gap-2.5 truncate">
                    <span class="w-6 h-6 rounded bg-slate-100 text-slate-700 font-mono font-bold text-xs flex items-center justify-center shrink-0">
                        ${prog.id}
                    </span>
                    <div class="truncate">
                        <div class="text-xs font-semibold text-slate-900 truncate">${escapeHtml(prog.title)}</div>
                        <div class="text-[11px] text-slate-500 truncate">${escapeHtml(prog.description)}</div>
                    </div>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400 shrink-0"></i>
            `;
            return btn;
        }

        function filterTOC(query) {
            const q = query.toLowerCase();
            const items = document.querySelectorAll('.toc-item');
            items.forEach(it => {
                const text = it.textContent.toLowerCase();
                it.style.display = text.includes(q) ? 'flex' : 'none';
            });
        }

        // Concepts Modal
        function showConceptsModal() {
            const modal = document.getElementById('concepts-modal');
            const container = document.getElementById('concepts-list-container');
            container.innerHTML = '';

            for (const [key, c] of Object.entries(DBMS_CONCEPTS)) {
                const card = document.createElement('div');
                card.className = "bg-white border border-slate-200 rounded-lg p-3.5 space-y-1.5 shadow-sm";

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">${escapeHtml(c.title)}</h4>
                        <button onclick="askThanganAboutCheatsheetConcept('${escapeJsString(key)}')" class="text-[11px] text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded hover:bg-blue-100 transition-colors">
                            Ask Thangan
                        </button>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">${escapeHtml(c.description)}</p>
                    <div class="code-container p-2 text-[11px] overflow-x-auto">
                        <pre><code>${escapeHtml(c.example)}</code></pre>
                    </div>
                    <p class="text-[11px] text-slate-500">💡 <strong>Examiner Tip:</strong> ${escapeHtml(c.examTip)}</p>
                `;

                container.appendChild(card);
            }

            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeConceptsModal() {
            document.getElementById('concepts-modal').classList.add('hidden');
        }

        function askThanganAboutCheatsheetConcept(key) {
            closeConceptsModal();
            scrollToDiscussion();
            window.aiTutor.setMode('tutor');
            document.getElementById('nb-discussion-input').value = `Thangan, explain the concept "${key}" in depth with examples from my lab record.`;
            handleNotebookDiscussionSubmit(new Event('submit'));
        }

        // Settings Modal
        function openSettingsModal() {
            document.getElementById('settings-modal').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('settings-modal').classList.add('hidden');
        }

        function initSettingsState() {
            const provider = window.aiTutor.customConfig.provider;
            const radios = document.querySelectorAll('input[name="ai_provider"]');
            radios.forEach(r => {
                if (r.value === provider) r.checked = true;
                r.addEventListener('change', (e) => {
                    const keyContainer = document.getElementById('api-key-container');
                    keyContainer.style.display = (e.target.value === 'gemini') ? 'block' : 'none';
                });
            });
            document.getElementById('custom-api-key-input').value = window.aiTutor.customConfig.apiKey || '';
            const keyContainer = document.getElementById('api-key-container');
            keyContainer.style.display = (provider === 'gemini') ? 'block' : 'none';
        }

        function saveProviderSettings() {
            const selected = document.querySelector('input[name="ai_provider"]:checked').value;
            const apiKey = document.getElementById('custom-api-key-input').value.trim();

            window.aiTutor.customConfig.provider = selected;
            window.aiTutor.customConfig.apiKey = apiKey;
            localStorage.setItem('dbms_ai_provider', selected);
            localStorage.setItem('dbms_ai_api_key', apiKey);

            closeSettingsModal();
            alert('Settings updated successfully!');
        }

        // Helpers
        function copyToClipboard(btn, text) {
            navigator.clipboard.writeText(text);
            const original = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="check" class="w-3 h-3 text-emerald-600"></i><span class="text-emerald-700 font-medium">Copied!</span>`;
            lucide.createIcons();
            setTimeout(() => {
                btn.innerHTML = original;
                lucide.createIcons();
            }, 1800);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function escapeJsString(str) {
            if (!str) return '';
            return str.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$/g, '\\$');
        }
    </script>
</body>
</html>