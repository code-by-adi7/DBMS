    <!-- TABLE OF CONTENTS (INDEX) MODAL -->
    <div id="toc-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/40 backdrop-blur-xs p-0 sm:p-4 transition-all">
        <div class="bg-white border-t sm:border border-slate-200 rounded-t-2xl sm:rounded-xl w-full max-w-xl max-h-[90vh] sm:max-h-[85vh] flex flex-col shadow-2xl overflow-hidden">
            <!-- Header -->
            <div class="p-3.5 sm:p-4 border-b border-slate-200 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        <i data-lucide="book-open" class="w-4 h-4 text-blue-600"></i>
                        <span>Lab Notebook Index</span>
                    </h3>
                    <p class="text-xs text-slate-500 mt-0.5">Jump directly to any of the 14 lab exercises.</p>
                </div>
                <button onclick="toggleTOCModal()" class="text-slate-400 hover:text-slate-700 p-2 rounded-lg hover:bg-slate-100 transition-colors" aria-label="Close Index">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Search -->
            <div class="p-3 border-b border-slate-100 bg-slate-50">
